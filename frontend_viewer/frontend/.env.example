# Example environment configuration for the Next.js frontend
# Copy this file to `.env.local` (or `.env`) and adjust values for your environment.
#
# NOTE:
# - Variables without the NEXT_PUBLIC_ prefix are only available on the server
#   (e.g., inside app/api/* route handlers).
# - Variables prefixed with NEXT_PUBLIC_ are also exposed to the browser.


###############################################
# Ollama / LLM configuration
###############################################

# OLLAMA_MODEL (required)
# ------------------------
# Name of the Ollama model to use for chat completions in /api/chat.
# This should match a model that is available in your local Ollama instance
# (e.g., visible in `ollama list`).
#
# Used in: app/api/chat/route.ts
# Fallback in code: "gpt-oss:20b" if this is not set.
#
# REQUIRED for production; optional for local dev if you are happy with the default.
OLLAMA_MODEL=gpt-oss:20b

# OLLAMA_URL (optional)
# ---------------------
# Base URL of your local or remote Ollama server.
#
# Used in: app/api/chat/route.ts
# Fallback in code: http://localhost:11434 if this is not set.
#
# Optional: override if your Ollama server is not on localhost:11434.
OLLAMA_URL=http://localhost:11434


###############################################
# Backend API (vector search) configuration
###############################################

# NEXT_PUBLIC_API_URL (required for non-local backend)
# ----------------------------------------------------
# Base URL of the Python FastAPI backend that exposes the vector search API.
# The frontend calls `${NEXT_PUBLIC_API_URL}/api/search` from /api/search.
#
# Used in: app/api/search/route.ts
# Fallback in code: http://localhost:8000 if this is not set.
#
# For typical local development with the backend running on localhost:8000,
# you can either:
#   - leave this unset (the default http://localhost:8000 will be used), or
#   - set it explicitly as shown below.
#
# REQUIRED if your backend is exposed via a different host/port (e.g. ngrok).
NEXT_PUBLIC_API_URL=http://localhost:8000


###############################################
# Next.js / Environment flags (optional)
###############################################

# NODE_ENV (optional)
# --------------------
# Standard Node/Next.js environment flag.
# Next.js will usually manage this automatically ("development" or "production"),
# so you normally do not need to set it manually.
#NODE_ENV=development

